// frees-language: 2
function [port] = ThermalSource(T)
port(port)
  port.T = T
end

// Heat-flow source: injects a fixed thermal power Q into the connected node
// (port.Qdot = -Q, so the network receives +Q). The Qdot dual of ThermalSource.
function [port] = HeatSource(Q)
port(port)
  port.Qdot = -Q
end

function [a, b] = Conduction(k, area, L)
port(a)
port(b)
  Q      = k * area / L * (a.T - b.T)
  a.Qdot = Q
  b.Qdot = -Q
end

function [a, b] = Convection(htc, area)
port(a)
port(b)
  Q      = htc * area * (a.T - b.T)
  a.Qdot = Q
  b.Qdot = -Q
end

function [a, b] = Radiation(emis, area)
port(a)
port(b)
  Q      = emis * 5.670374419e-8 * area * (a.T^4 - b.T^4)
  a.Qdot = Q
  b.Qdot = -Q
end

function [port] = ThermalMass(C, T0)
port(port)
  der(port.T)  = port.Qdot / C
  init(port.T) = T0
end

// Thermal mass with internal heat generation: der(T) = (Qgen + Qdot)/C. Models a
// self-heating lump (battery pack, e-motor, cabin load) tied to a heat port.
function [port] = MassGen(C, Qgen, T0)
port(port)
  der(port.T)  = (Qgen + port.Qdot) / C
  init(port.T) = T0
end

function [a, b] = ContactResistance(Rth)
port(a)
port(b)
  Q      = (a.T - b.T) / Rth
  a.Qdot = Q
  b.Qdot = -Q
end

function [port] = ThermalSensor()
port(port)
  port.Qdot = 0
  T_meas    = port.T
end

// ── Thermal breadth (Wave 6) ───────────────────────────────────────────────

// Two-node transient wall: capacitance–conduction–capacitance, the classic RC
// warm-up wall between two heat ports.
function [a, b] = WallRC(C1, C2, R, T10, T20)
port(a)
port(b)
  der(T1)  = (a.Qdot - (T1 - T2) / R) / C1
  init(T1) = T10
  der(T2)  = ((T1 - T2) / R + b.Qdot) / C2
  init(T2) = T20
  a.T = T1
  b.T = T2
end

// Two-surface radiation enclosure: surface resistances (1−ε)/(εA) in series
// with the view-factor space resistance 1/(A1·F12), on the σ(T⁴−T⁴) potential.
function [a, b] = RadiationTwoSurface(e1, e2, A1, A2, F12)
port(a)
port(b)
  Rrad   = (1 - e1) / (e1 * A1) + 1 / (A1 * F12) + (1 - e2) / (e2 * A2)
  a.Qdot = 5.670374419e-8 * (a.T^4 - b.T^4) / Rrad
  a.Qdot + b.Qdot = 0
end

// Heat pipe: a very high effective conductance saturating smoothly at the
// transport limit Qmax (capillary/sonic), so overload degrades instead of
// diverging.
function [a, b] = HeatPipe(G, Qmax)
port(a)
port(b)
  a.Qdot = Qmax * tanh(G * (a.T - b.T) / Qmax)
  a.Qdot + b.Qdot = 0
end

// Phase-change-material mass: latent heat L released over a Gaussian mushy
// zone of width dTm around the melt point (∫cp_eff dT = cp·ΔT + L exactly).
function [port] = PCMMass(m, cp, L, Tm, dTm, T0)
port(port)
  cpe          = cp + (L / (dTm * 1.7724539)) * exp(-((port.T - Tm) / dTm)^2)
  der(port.T)  = port.Qdot / (m * cpe)
  init(port.T) = T0
end

// Peltier thermoelectric module: Seebeck voltage + ohmic drop electrically;
// Peltier pumping ± half-Joule and back-conduction thermally. Energy-exact:
// Q_hot − Q_cold = I·V.
function [p, n, hot, cold] = PeltierTEC(Sab, Rel, Kth)
port(p)
port(n)
port(hot)
port(cold)
  I         = p.I
  p.V - n.V = Sab * (hot.T - cold.T) + Rel * I
  p.I + n.I = 0
  Qc        = Sab * cold.T * I - 0.5 * Rel * I^2 - Kth * (hot.T - cold.T)
  Qh        = Sab * hot.T * I + 0.5 * Rel * I^2 - Kth * (hot.T - cold.T)
  cold.Qdot = Qc
  hot.Qdot  = -Qh
end

// Thermal switch / bimetal thermostat: a conductance that engages smoothly
// above the trip temperature (sensed on side a).
function [a, b] = ThermalSwitch(G, Ton, band)
port(a)
port(b)
  u      = 0.5 * (1 + tanh((a.T - Ton) / band))
  a.Qdot = u * G * (a.T - b.T)
  a.Qdot + b.Qdot = 0
end


// ── Electrochemistry & energy systems (Wave 8) ──────────────────────────────

// Cell-to-plate thermal path: contact/interface resistance into the cold-plate
// mass — the network that makes pack gradients (cell hot spot vs plate) real.
// (Direct equations: the plate node carries this component's own state.)
function [cell, plate] = CellToPackThermal(Rcc, Cpl, T0)
port(cell)
port(plate)
  Q         = (cell.T - Tp) / Rcc
  cell.Qdot = Q
  der(Tp)   = (Q + plate.Qdot) / Cpl
  init(Tp)  = T0
  plate.T   = Tp
end


// ── HVAC, buildings & process-lite (Wave 9) ─────────────────────────────────

// Two-zone partition wall: surface films (h_a, h_b) into two face masses with
// U·A conduction between them. The ports are resistive — they READ the zone
// temperatures — so the wall composes directly with any temperature-setting
// zone (CabinZone, MassGen) without C-C adjacency.
function [a, b] = MultiZoneWall(h_a, h_b, U, A, C1, C2, T10, T20)
port(a)
port(b)
  qa       = h_a * A * (a.T - T1)
  a.Qdot   = qa
  q        = U * A * (T1 - T2)
  der(T1)  = (qa - q) / C1
  init(T1) = T10
  qb       = h_b * A * (T2 - b.T)
  b.Qdot   = -qb
  der(T2)  = (q - qb) / C2
  init(T2) = T20
end
