// frees-language: 2
function [p, n] = VoltageSource(E [V])
port(p)
port(n)
  p.V - n.V = E
  p.I + n.I = 0
end

function [a, b] = Resistor(R [ohm])
port(a)
port(b)
  a.V - b.V = R * a.I
  a.I + b.I = 0
end

function [port] = Ground()
port(port)
  port.V = 0
end

function [p, n] = Battery(Voc [V], R0 [ohm])
port(p)
port(n)
  p.V - n.V = Voc + R0 * p.I
  p.I + n.I = 0
  W = (p.V - n.V) * (0 - p.I)
end

function [p, n, heat] = HeatingResistor(R [ohm])
port(p)
port(n)
port(heat)
  p.V - n.V = R * p.I
  p.I + n.I = 0
  Q         = (p.V - n.V) * p.I
  heat.Qdot = -Q
end

function [p, n, heat] = BatteryThermal(Voc [V], R0 [ohm])
port(p)
port(n)
port(heat)
  p.V - n.V = Voc + R0 * p.I
  p.I + n.I = 0
  Q         = R0 * p.I^2
  heat.Qdot = -Q
  W         = (p.V - n.V) * (0 - p.I)
end

function [p, n] = Capacitor(C [farad], V0 [V])
port(p)
port(n)
  Vc       = p.V - n.V
  der(Vc)  = p.I / C
  init(Vc) = V0
  p.I + n.I = 0
end

function [p, n] = Inductor(L [henry], I0 [A])
port(p)
port(n)
  der(IL)  = (p.V - n.V) / L
  init(IL) = I0
  p.I = IL
  p.I + n.I = 0
end

function [p, n, heat] = BatteryTransient(Voc [V], R0 [ohm], Q0 [-], C_th [J/K], SOC0, T0 [K])
port(p)
port(n)
port(heat)
  p.V - n.V = Voc + R0 * p.I
  p.I + n.I = 0
  Qgen      = R0 * p.I^2
  heat.T    = T
  der(T)    = (Qgen + heat.Qdot) / C_th
  init(T)   = T0
  der(SOC)  = p.I / (3600 [A-s] * Q0)
  init(SOC) = SOC0
end

function [p, n, shaft] = DCMotor(Kt [N-m/A], Ke [V-s/rad], R [ohm])
port(p)
port(n)
port(shaft)
  p.V - n.V  = R * p.I + Ke * shaft.w
  p.I + n.I  = 0
  shaft.tau  = -Kt * p.I
end

function [p, n] = BatteryRC(Voc [V], R0 [ohm], R1 [ohm], C1 [farad], Vrc0 [V])
port(p)
port(n)
  p.V - n.V = Voc + R0 * p.I - Vrc
  der(Vrc)  = -p.I / C1 - Vrc / (R1 * C1)
  init(Vrc) = Vrc0
  p.I + n.I = 0
end

function [p, n] = Diode(Gon [siemens], eps)
port(p)
port(n)
  vd  = p.V - n.V
  p.I = Gon * vd * (0.5 + 0.5 * tanh(vd / eps))
  p.I + n.I = 0
end

function [p, n, shaft] = PMSM(Rs [ohm], lambda_pm [Wb], poles)
port(p)
port(n)
port(shaft)
  Kt        = 1.5 * poles * lambda_pm
  p.V - n.V = Rs * p.I + Kt * shaft.w
  p.I + n.I = 0
  shaft.tau = -Kt * p.I
end

function [p, n] = CurrentSource(I [A])
port(p)
port(n)
  p.I = -I
  p.I + n.I = 0
end

function [p, n] = Battery2RC(Voc [V], R0 [ohm], R1 [ohm], C1 [farad], R2 [ohm], C2 [farad], Vrc1_0 [V], Vrc2_0 [V])
port(p)
port(n)
  p.V - n.V  = Voc + R0 * p.I - Vrc1 - Vrc2
  der(Vrc1)  = -p.I / C1 - Vrc1 / (R1 * C1)
  init(Vrc1) = Vrc1_0
  der(Vrc2)  = -p.I / C2 - Vrc2 / (R2 * C2)
  init(Vrc2) = Vrc2_0
  p.I + n.I  = 0
end

function [p, n, heat] = FuelCellStack(ncells, area [m^2], i0 [A/m^2], ilim [A/m^2], Rohm [ohm-m^2], E0 [V], alpha, Eth [V], T [K])
port(p)
port(n)
port(heat)
  I_cell    = -p.I
  i         = I_cell / area
  V_cell    = E0 - (8.314 [J/mol-K] * T / (alpha * 96485 [A-s/mol])) * ln(i / i0) - i * Rohm - (8.314 [J/mol-K] * T / (2 * 96485 [A-s/mol])) * ln(ilim / (ilim - i))
  p.V - n.V = ncells * V_cell
  p.I + n.I = 0
  Q         = I_cell * ncells * (Eth - V_cell)
  heat.Qdot = -Q
end

// ── Electrification set (Wave 3) ───────────────────────────────────────────

// Map-based battery cell — the real ECM rung: open-circuit voltage from an
// OCV(SOC) TABLE, ohmic resistance with an Arrhenius temperature law, and the
// Bernardi heat Q = I²R − I·T·(dU/dT)(SOC) (entropic term from a dU/dT map).
// SOC and cell temperature are states; the `aging` variant adds Ah-throughput
// capacity fade (Qcap = Q0·(1 − k_age·Ah)). Discharge current is positive
// (I = −p.I, matching the Battery sign convention).
function [p, n, heat] = BatteryCellMap(ocv$, dudt$, R0ref [ohm], Tref [K], Ea [J/mol], Q0 [-], C_th [J/K], SOC0 [-], T0 [K], k_age [-], R1 [ohm], C1 [farad], k_cal [1/s], Ea_cal [J/mol], model$ = static)
port(p)
port(n)
port(heat)
  I         = -p.I
  R0        = R0ref * exp((Ea / 8.314 [J/mol-K]) * (1 / T - 1 / Tref))
  Voc       = ocv$(SOC)
  p.I + n.I = 0
  der(SOC)  = -I / (3600 [A-s] * Qcap)
  init(SOC) = SOC0
  Qgen      = R0 * I^2 - I * T * dudt$(SOC)
  heat.T    = T
  der(T)    = (Qgen + heat.Qdot) / C_th
  init(T)   = T0
  VARIANT static
    Qcap      = Q0
    p.V - n.V = Voc - R0 * I
  END
  VARIANT aging REQUIRE k_age
    der(Ah)   = abs(I) / 3600 [A-s]
    init(Ah)  = 0
    Qcap      = Q0 * (1 - k_age * Ah)
    p.V - n.V = Voc - R0 * I
  END
  VARIANT rc_map REQUIRE R1, C1
    der(v1)   = I / C1 - v1 / (R1 * C1)
    init(v1)  = 0
    Qcap      = Q0
    p.V - n.V = Voc - R0 * I - v1
  END
  VARIANT aging_cal REQUIRE k_age, k_cal, Ea_cal
    der(Ah)   = abs(I) / 3600 [A-s]
    init(Ah)  = 0
    der(fcal) = k_cal * exp(-Ea_cal / (8.314 [J/mol-K] * T))
    init(fcal) = 0
    Qcap      = Q0 * (1 - k_age * Ah - fcal)
    p.V - n.V = Voc - R0 * I
  END
end

// Battery pack: Ns series × Np parallel of the map cell, lumped (uniform SOC
// and temperature — the standard pack-level rung). C_th is the PACK thermal
// mass; heat generation scales with the cell count.
function [p, n, heat] = BatteryPack(Ns [-], Np [-], ocv$, dudt$, R0ref [ohm], Tref [K], Ea [J/mol], Q0 [-], C_th [J/K], SOC0 [-], T0 [K])
port(p)
port(n)
port(heat)
  I_cell    = -p.I / Np
  R0        = R0ref * exp((Ea / 8.314 [J/mol-K]) * (1 / T - 1 / Tref))
  p.V - n.V = Ns * (ocv$(SOC) - R0 * I_cell)
  p.I + n.I = 0
  der(SOC)  = -I_cell / (3600 [A-s] * Q0)
  init(SOC) = SOC0
  Qgen      = Ns * Np * (R0 * I_cell^2 - I_cell * T * dudt$(SOC))
  heat.T    = T
  der(T)    = (Qgen + heat.Qdot) / C_th
  init(T)   = T0
end

// Map-efficiency e-machine: torque command on the signal port u [N·m], losses
// from a 2-D efficiency map eff$(ω, τ). Four-quadrant: motoring draws
// P_mech/η from the DC bus, generating returns P_mech·η, blended smoothly
// through zero mechanical power (width epsP [W]). Loss heat exits `heat`.
function [p, n, shaft, heat, u] = MotorMap(eff$, epsP [W])
port(p)
port(n)
port(shaft)
port(heat)
port(u)
  tau_e     = u.sig
  shaft.tau = -tau_e
  Pm        = tau_e * shaft.w
  eff       = eff$(shaft.w, tau_e)
  s         = 0.5 * (1 + tanh(Pm / epsP))
  Pe        = s * Pm / eff + (1 - s) * Pm * eff
  (p.V - n.V) * p.I = Pe
  p.I + n.I = 0
  Q         = Pe - Pm
  heat.Qdot = -Q
end

// Series inverter loss element: conduction (device drop V0 + r·I) plus
// switching loss folded into an equivalent drop Vsw = Esw·fsw·Vnom/(Iref·Vref)
// — energy-consistent (Q = ΔV·I exactly), tanh-smooth through zero current.
function [in_p, out_p, heat] = InverterLoss(V0 [V], r [ohm], Esw [J], fsw [Hz], Iref [A], Vref [V], Vnom [V], epsI [A])
port(in_p)
port(out_p)
port(heat)
  I         = in_p.I
  in_p.I + out_p.I = 0
  Vsw       = Esw * fsw * Vnom / (Iref * Vref)
  dV        = (V0 + Vsw) * tanh(I / epsI) + r * I
  out_p.V   = in_p.V - dV
  Q         = dV * I
  heat.Qdot = -Q
end

// Ideal-transformer DC/DC converter with a fixed voltage ratio and a
// four-quadrant efficiency (forward power / eta, reverse power · eta).
function [in_p, in_n, out_p, out_n] = DCDCConverter(ratio [-], eta [-], epsP [W])
port(in_p)
port(in_n)
port(out_p)
port(out_n)
  out_p.V - out_n.V = ratio * (in_p.V - in_n.V)
  in_p.I + in_n.I   = 0
  out_p.I + out_n.I = 0
  Pout = (out_p.V - out_n.V) * (0 - out_p.I)
  s    = 0.5 * (1 + tanh(Pout / epsP))
  Pin  = s * Pout / eta + (1 - s) * Pout * eta
  Pin  = (in_p.V - in_n.V) * in_p.I
end

// Supercapacitor: ideal capacitance with an equivalent series resistance.
function [p, n] = Supercapacitor(C [farad], R_esr [ohm], V0 [V])
port(p)
port(n)
  der(Vc)   = p.I / C
  init(Vc)  = V0
  p.V - n.V = Vc + R_esr * p.I
  p.I + n.I = 0
end

// CC-CV charger: sources Imax until the terminal voltage approaches Vmax,
// then tapers (tanh, width epsV) — the constant-current / constant-voltage
// profile with no mode switch.
function [p, n] = ChargerCCCV(Imax [A], Vmax [V], epsV [V])
port(p)
port(n)
  V   = p.V - n.V
  p.I = -Imax * 0.5 * (1 + tanh((Vmax - V) / epsV))
  p.I + n.I = 0
end

// Thermal fuse: the element resistance multiplies by (1 + kR) once |I|
// exceeds the blow rating (tanh, width epsI) — a continuous overcurrent trip.
function [p, n] = ThermalFuse(R0 [ohm], Iblow [A], kR [-], epsI [A])
port(p)
port(n)
  m         = 1 + kR * 0.5 * (1 + tanh((abs(p.I) - Iblow) / epsI))
  p.V - n.V = R0 * m * p.I
  p.I + n.I = 0
end

// Harness/busbar resistance with the copper temperature coefficient, sensing
// its temperature on the heat port and dissipating I²R there.
function [a, b, heat] = HarnessResistance(R20 [ohm], alphaT [1/K])
port(a)
port(b)
port(heat)
  R         = R20 * (1 + alphaT * (heat.T - 293.15))
  a.V - b.V = R * a.I
  a.I + b.I = 0
  Q         = R * a.I^2
  heat.Qdot = -Q
end

// PEM electrolyzer stack (reverse fuel cell): reversible potential + activation
// (ln(i/i0 + 1), regular at zero current) + ohmic overpotentials; hydrogen
// production from Faraday's law; heat above the thermoneutral voltage Eth.
function [p, n, heat] = Electrolyzer(ncells [-], area [m^2], i0 [A/m^2], Rohm [ohm-m^2], E0 [V], alpha [-], Eth [V], T [K])
port(p)
port(n)
port(heat)
  I_cell    = p.I
  i         = I_cell / area
  V_cell    = E0 + (8.314 [J/mol-K] * T / (alpha * 96485 [A-s/mol])) * ln(i / i0 + 1) + i * Rohm
  p.V - n.V = ncells * V_cell
  p.I + n.I = 0
  mdot_h2   = ncells * I_cell * 2.016e-3 [kg/mol] / (2 * 96485 [A-s/mol])
  Q         = I_cell * ncells * (V_cell - Eth)
  heat.Qdot = -Q
end

// Solar array: photocurrent proportional to the irradiance signal G [W/m²],
// with a smooth open-circuit clamp at Voc — the constant-current PV rung.
function [p, n, G] = SolarArray(Isc_ref [A], Gref [W/m^2], Voc [V], epsV [V])
port(p)
port(n)
port(G)
  Iph = Isc_ref * G.sig / Gref
  V   = p.V - n.V
  p.I = -Iph * 0.5 * (1 + tanh((Voc - V) / epsV))
  p.I + n.I = 0
end


// ── Electrochemistry & energy systems (Wave 8) ──────────────────────────────

// Single-diode PV module: I = Iph − I0·(exp(Vd/(n·Vt)) − 1) − Vd/Rsh with the
// series-resistance diode voltage Vd = V + I·Rs — the physics rung above
// SolarArray's clamp model. Current is signed out of p (sourcing).
function [p, n, G] = PVSingleDiode(Isc_ref [A], Gref [W/m^2], I0d [A], n_d [-], Vt [V], Rs [ohm], Rsh [ohm])
port(p)
port(n)
port(G)
  V   = p.V - n.V
  I   = -p.I
  Iph = Isc_ref * G.sig / Gref
  Vd  = V + I * Rs
  I   = Iph - I0d * (exp(Vd / (n_d * Vt)) - 1) - Vd / Rsh
  p.I + n.I = 0
end

// PEM stack with a coolant jacket: the electrochemical stack's waste heat
// crosses into a liquid loop through a UA wall (drop-in for FuelCellStack
// when the thermal loop matters).
function [p, n, cool_in, cool_out] = FuelCellStackCooled(ncells [-], area [m^2], i0 [A/m^2], ilim [A/m^2], Rohm [ohm-m^2], E0 [V], alpha [-], Eth [V], T [K], fluid$, UA [W/K])
port(p)
port(n)
port(cool_in)
port(cool_out)
  FuelCellStack FC(ncells=ncells, area=area, i0=i0, ilim=ilim, Rohm=Rohm, E0=E0, alpha=alpha, Eth=Eth, T=T)
  LiquidWallHX  HX(fluid$=fluid$, UA=UA)
  connect(p, FC.p)
  connect(n, FC.n)
  connect(FC.heat, HX.wall)
  connect(cool_in, HX.in)
  connect(HX.out, cool_out)
end

// Electrolyzer with a coolant jacket (same pattern as the cooled stack).
function [p, n, cool_in, cool_out] = ElectrolyzerThermal(ncells [-], area [m^2], i0 [A/m^2], Rohm [ohm-m^2], E0 [V], alpha [-], Eth [V], T [K], fluid$, UA [W/K])
port(p)
port(n)
port(cool_in)
port(cool_out)
  Electrolyzer EL(ncells=ncells, area=area, i0=i0, Rohm=Rohm, E0=E0, alpha=alpha, Eth=Eth, T=T)
  LiquidWallHX HX(fluid$=fluid$, UA=UA)
  connect(p, EL.p)
  connect(n, EL.n)
  connect(EL.heat, HX.wall)
  connect(cool_in, HX.in)
  connect(HX.out, cool_out)
end

// Map-referenced maximum-power-point command: Vmp from an irradiance map
// (perturb-free analytic tracking; pair with PVSingleDiode + a DC-DC stage).
function [G, out] = MPPTBlock(vmp$)
port(G)
port(out)
  out.sig = vmp$(G.sig)
end

// ── Teaching primitives (Phase J) ────────────────────────────────────────────
// Each switches through a signal input or a smooth law, never by changing the
// circuit: the equation set is the same open or closed.

// Signal-driven switch: the conductance moves from 1/Roff to 1/Ron as ctrl
// passes thresh (tanh, width eps).
function [p, n, ctrl] = Switch(Ron [ohm], Roff [ohm], thresh, eps)
port(p)
port(n)
port(ctrl)
  w   = 0.5 * (1 + tanh((ctrl.sig - thresh) / eps))
  G   = w / Ron + (1 - w) / Roff
  p.I = G * (p.V - n.V)
  p.I + n.I = 0
end

// Signal-driven changeover (SPDT): com joins a while ctrl > thresh, b below.
function [com, a, b, ctrl] = SwitchSPDT(Ron [ohm], Roff [ohm], thresh, eps)
port(com)
port(a)
port(b)
port(ctrl)
  w   = 0.5 * (1 + tanh((ctrl.sig - thresh) / eps))
  a.I = (w / Ron + (1 - w) / Roff) * (a.V - com.V)
  b.I = ((1 - w) / Ron + w / Roff) * (b.V - com.V)
  com.I + a.I + b.I = 0
end

// Sinusoidal voltage source: v = Voff + Vamp·sin(2π·freq·t + phase).
function [p, n] = SineVoltageSource(Vamp [V], freq [Hz], phase [rad], Voff [V])
port(p)
port(n)
  p.V - n.V = Voff + Vamp * sin(2 * pi# * freq * time + phase)
  p.I + n.I = 0
end

// Sinusoidal current source, driving i = Ioff + Iamp·sin(2π·freq·t + phase)
// out of p through the external circuit.
function [p, n] = SineCurrentSource(Iamp [A], freq [Hz], phase [rad], Ioff [A])
port(p)
port(n)
  p.I = -(Ioff + Iamp * sin(2 * pi# * freq * time + phase))
  p.I + n.I = 0
end

// Signal-controlled voltage source: v = k·in.
function [p, n, in] = SignalVoltageSource(k [V])
port(p)
port(n)
port(in)
  p.V - n.V = k * in.sig
  p.I + n.I = 0
end

// Signal-controlled current source: i = k·in out of p.
function [p, n, in] = SignalCurrentSource(k [A])
port(p)
port(n)
port(in)
  p.I = -k * in.sig
  p.I + n.I = 0
end

// Ideal transformer, turns ratio N = N1/N2: v1 = N·v2 and N·i1 + i2 = 0, so
// it stores and dissipates nothing. Each winding is its own loop.
function [p1, n1, p2, n2] = IdealTransformer(N [-])
port(p1)
port(n1)
port(p2)
port(n2)
  p1.V - n1.V = N * (p2.V - n2.V)
  p2.I = -N * p1.I
  p1.I + n1.I = 0
  p2.I + n2.I = 0
end

// Ideal op-amp with rails: no input current, open-loop gain A, and an output
// (referred to ground) that saturates smoothly at Vneg and Vpos.
function [inp, inn, out] = OpAmp(A [-], Vpos [V], Vneg [V])
port(inp)
port(inn)
port(out)
  inp.I = 0
  inn.I = 0
  Vmid  = 0.5 * (Vpos + Vneg)
  Vhalf = 0.5 * (Vpos - Vneg)
  out.V = Vmid + Vhalf * tanh(A * (inp.V - inn.V) / Vhalf)
end

// Zener diode (p = anode): forward conduction above 0 V, reverse breakdown
// below −Vz, each a smooth ramp of conductance Gon (width eps).
function [p, n] = Zener(Vz [V], Gon [siemens], eps [V])
port(p)
port(n)
  vd  = p.V - n.V
  vr  = -vd - Vz
  p.I = Gon * (vd * 0.5 * (1 + tanh(vd / eps)) - vr * 0.5 * (1 + tanh(vr / eps)))
  p.I + n.I = 0
end

// Potentiometer: track resistance R between a and b, wiper w at fraction pos
// from a (clamped to 0…1).
function [a, b, w] = Potentiometer(R [ohm], pos [-])
port(a)
port(b)
port(w)
  x = min(1, max(0, pos))
  a.V - w.V = R * x * a.I
  w.V - b.V = -R * (1 - x) * b.I
  a.I + b.I + w.I = 0
end

// NTC thermistor, beta model R = R0·exp(B·(1/T − 1/T0)) at the heat-port
// temperature; its Joule heat leaves through that port (self-heating).
function [p, n, heat] = Thermistor(R0 [ohm], B [K], T0 [K])
port(p)
port(n)
port(heat)
  R         = R0 * exp(B * (1 / heat.T - 1 / T0))
  p.V - n.V = R * p.I
  p.I + n.I = 0
  heat.Qdot = -(p.V - n.V) * p.I
end

// Incandescent lamp: a filament whose resistance rises as (Tf/T0)^kexp, heated
// by its own current and cooled by radiation (emissivity × area epsA) to Tamb.
// A cold filament draws an inrush current until it heats.
function [p, n] = Lamp(R0 [ohm], T0 [K], kexp [-], C_th [J/K], epsA [m^2], Tamb [K], Tf0 [K])
port(p)
port(n)
  R         = R0 * (Tf / T0)^kexp
  p.V - n.V = R * p.I
  p.I + n.I = 0
  Pel       = (p.V - n.V) * p.I
  Prad      = epsA * sigma# * (Tf^4 - Tamb^4)
  der(Tf)   = (Pel - Prad) / C_th
  init(Tf)  = Tf0
end
