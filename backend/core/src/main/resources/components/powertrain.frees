COMPONENT Engine(shaft)
  PARAM Tmax, throttle, bf
  shaft.tau = -(throttle * Tmax - bf * shaft.w)
END

COMPONENT RoadLoad(shaft)
  PARAM Crr, Caero
  shaft.tau = Crr + Caero * shaft.w^2
END

// Mean-value engine with a WOT-torque fidelity ladder: the original parabolic
// wide-open-throttle curve, or a tabulated WOT map (dyno data) via map_wot$.
COMPONENT MeanValueEngine(shaft)
  PARAM throttle, Tpeak, w_peak, FMEP_a, FMEP_b, map_wot$, model$ = parabolic
  T_ind     = throttle * T_wot
  T_fric    = FMEP_a + FMEP_b * shaft.w
  shaft.tau = -(T_ind - T_fric)
  VARIANT parabolic REQUIRE Tpeak, w_peak
    T_wot = Tpeak * (1 - ((shaft.w - w_peak) / w_peak)^2)
  END
  VARIANT wotmap REQUIRE map_wot$
    T_wot = map_wot$(shaft.w)
  END
END

COMPONENT Transmission(in, out)
  PARAM ratio, eta
  in.w    = ratio * out.w
  out.tau = -ratio * eta * in.tau
END

COMPONENT GradeRoadLoad(shaft)
  PARAM Crr, Caero, m, g, grade
  shaft.tau = Crr + Caero * shaft.w^2 + m * g * sin(grade)
END

// ── Vehicle set (Wave 4) ───────────────────────────────────────────────────

// Torque converter (K-factor form): pump torque (ω_p/K(SR))², torque ratio
// TR(SR), SR = ω_turbine/ω_pump — both from 1-D TABLEs of the converter sheet.
COMPONENT TorqueConverter(pump, turb)
  PARAM Kmap$, TRmap$
  SR       = turb.w / pump.w
  tau_p    = (pump.w / Kmap$(SR))^2
  pump.tau = tau_p
  turb.tau = -TRmap$(SR) * tau_p
END

// Longitudinal tire (Pacejka-lite magic formula on longitudinal slip): bridges
// the wheel (rotational) to the vehicle (translational). Fx = Fz·D·sin(C·atan(B·s)),
// s = (rω − v)/(|v| + epsv). Drive torque reaction r·Fx loads the wheel.
COMPONENT TireLongitudinal(wheel, veh)
  PARAM r, Fz, B, C, D, epsv
  v_w       = r * wheel.w
  slip      = (v_w - veh.vel) / (abs(veh.vel) + epsv)
  Fx        = Fz * D * sin(C * arctan(B * slip))
  veh.f     = -Fx
  wheel.tau = r * Fx
END

// Longitudinal vehicle body: mass with aero drag, rolling resistance
// (tanh-signed) and grade load; velocity is the state.
COMPONENT VehicleBody(port)
  PARAM m, Cd, Af, rhoA, Crr, grade, v0
  F_res = 0.5 * rhoA * Cd * Af * port.vel * abs(port.vel) + m * 9.80665 * (Crr * tanh(port.vel / 0.1) + sin(grade))
  der(port.vel)  = (port.f - F_res) / m
  init(port.vel) = v0
END

// Drive-cycle source: imposes a tabulated speed trace v = map$(t) on a
// translational port (WLTP, NEDC, any TABLE over time).
COMPONENT DriveCycleSource(port)
  PARAM map$
  port.vel = map$(time)
END

// Open differential: splits torque evenly, averages speeds through the final
// ratio (power-conserving).
COMPONENT Differential(in, left, right)
  PARAM ratio
  in.w      = ratio * 0.5 * (left.w + right.w)
  left.tau  = -0.5 * ratio * in.tau
  right.tau = -0.5 * ratio * in.tau
END

// Quarter-car suspension: sprung/unsprung masses, suspension spring+damper,
// tire stiffness — a composite of the translational primitives; excite `road`
// with a speed source or drive-cycle profile.
COMPONENT QuarterCar(road)
  PARAM ms, mu, ks, cs, kt
  TransMass   MS(m=ms, v0=0)
  TransMass   MU(m=mu, v0=0)
  TransSpring KS(k=ks, x0=0)
  TransDamper CS(c=cs)
  TransSpring KT(k=kt, x0=0)
  connect(MS.port, KS.a, CS.a)
  connect(KS.b, CS.b, MU.port, KT.a)
  connect(KT.b, road)
END
