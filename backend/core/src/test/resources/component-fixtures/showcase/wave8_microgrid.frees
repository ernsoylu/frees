// Wave 8 showcase — microgrid day cycle: a single-diode PV module charges an
// RC-map battery against a resistive load over a 6-hour irradiance bell.
// Charge bookkeeping must close exactly: the SOC change equals the integrated
// battery current over 3600*Q0 (in-fixture law replica), and the PV delivers
// its full photocurrent at noon.
// EXPECT soc_res = 0 tol 1e-9
// EXPECT i_noon = 6 tol 0.05

TABLE day(t)
  0      0
  5400   1000
  10800  0
END
TABLE ocv(soc)
  0    3.5
  1    3.9
END
TABLE dudt(soc)
  0    0
  1    0
END
SigTable       SUN(map$=day)
PVSingleDiode  PV(Isc_ref=6, Gref=1000, I0d=1e-9, n_d=2, Vt=0.3, Rs=1e-6, Rsh=1e6)
BatteryCellMap CELL(ocv$=ocv, dudt$=dudt, R0ref=0.01, Tref=300, Ea=0, Q0=10, C_th=500, SOC0=0.5, T0=300, R1=0.01, C1=800, model$=rc_map)
HeatingResistor LOADR(R=1)
ThermalSource  SINKT(T=300)
Ground         GND()
connect(SUN.out, PV.G)
connect(PV.p, CELL.p, LOADR.p)
connect(PV.n, CELL.n, LOADR.n, GND.port)
connect(LOADR.heat, SINKT.port)
CELL.heat.Qdot = 0

DYNAMIC daycycle(method = ode23s, time = 0 .. 10800, points = 600)
  der(qint) = CELL.I
  qint(0) = 0
END
soc_res = (FinalValue('cell.SOC') - 0.5) + FinalValue('qint') / (3600 * 10)
i_noon  = MaxValue('pv.I')
