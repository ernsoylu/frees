// Map battery cell, 10 A discharge for 360 s with a linear OCV (3.0..4.2 V),
// no Arrhenius (Ea=0): SOC 0.9 -> 0.8, terminal V = 3 + 1.2*0.8 - 0.01*10.
// The 4s2p pack twin at 20 A sees the same 10 A per cell: V = 4*(same).
// EXPECT soc_fin = 0.8 tol 1e-4
// EXPECT v_fin = 3.86 tol 2e-3
// EXPECT socp_fin = 0.8 tol 1e-4
// EXPECT vp_fin = 15.44 tol 8e-3
TABLE ocv(soc)
  0   3.0
  1   4.2
END
TABLE dudt(soc)
  0   -1e-4
  1   -1e-4
END
BatteryCellMap BAT(ocv$=ocv, dudt$=dudt, R0ref=0.01, Tref=298.15, Ea=0, Q0=10, C_th=500, SOC0=0.9, T0=300)
CurrentSource  LOAD(I=-10)
Ground         G()
HeatSource     ADB(Q=0)
connect(BAT.p, LOAD.p)
connect(BAT.n, LOAD.n, G.port)
connect(BAT.heat, ADB.port)
BatteryPack   PACK(Ns=4, Np=2, ocv$=ocv, dudt$=dudt, R0ref=0.01, Tref=298.15, Ea=0, Q0=10, C_th=2000, SOC0=0.9, T0=300)
CurrentSource LOADP(I=-20)
Ground        GP()
HeatSource    ADBP(Q=0)
connect(PACK.p, LOADP.p)
connect(PACK.n, LOADP.n, GP.port)
connect(PACK.heat, ADBP.port)
DYNAMIC dis(method = ode23s, time = 0 .. 360, points = 200)
END
soc_fin  = FinalValue('bat.soc')
v_fin    = FinalValue('bat.p.v') - FinalValue('bat.n.v')
socp_fin = FinalValue('pack.soc')
vp_fin   = FinalValue('pack.p.v') - FinalValue('pack.n.v')
