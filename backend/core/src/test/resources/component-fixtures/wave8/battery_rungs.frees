// BatteryCellMap fidelity rungs. rc_map at constant 10 A discharge: the RC
// branch settles to I*R1 = 0.2 V, so the terminal reads OCV - I*R0 - 0.2 =
// 3.7 - 0.05 - 0.2 = 3.45 V (flat 3.7 V OCV map, zero entropic term).
// aging_cal with k_age = 0, Ea_cal = 0: fcal = k_cal*t exactly, so capacity
// after 600 s is Q0*(1 - 6e-4) = 9.994 Ah.
// EXPECT v_rc = 3.45 tol 1e-4
// EXPECT qcap_fin = 9.994 tol 1e-6

TABLE ocv(soc)
  0    3.7
  1    3.7
END
TABLE dudt(soc)
  0    0
  1    0
END
CurrentSource  LOAD(I=-10)
Ground         GND()
BatteryCellMap CELL(ocv$=ocv, dudt$=dudt, R0ref=0.005, Tref=300, Ea=0, Q0=10, C_th=200, SOC0=0.8, T0=300, R1=0.02, C1=500, model$=rc_map)
connect(CELL.p, LOAD.p)
connect(CELL.n, LOAD.n, GND.port)
CELL.heat.Qdot = 0

CurrentSource  LOAD2(I=-1)
Ground         GND2()
BatteryCellMap CAL(ocv$=ocv, dudt$=dudt, R0ref=0.005, Tref=300, Ea=0, Q0=10, C_th=200, SOC0=0.8, T0=300, k_age=0, k_cal=1e-6, Ea_cal=0, model$=aging_cal)
connect(CAL.p, LOAD2.p)
connect(CAL.n, LOAD2.n, GND2.port)
CAL.heat.Qdot = 0

DYNAMIC dis(method = ode23s, time = 0 .. 600, points = 300)
END
v_rc     = FinalValue('cell.p.V') - FinalValue('cell.n.V')
qcap_fin = FinalValue('cal.Qcap')
