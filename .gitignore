/target
**/target
/pkg
/web/node_modules
/web/dist
# Generated by wasm-pack (see web/WASM-PORT.md for the rebuild command)
web/src/wasm/pkg/
# ...and where wasm-pack puts it when --out-dir is omitted. A stale copy sat
# here untracked from 2026-08-21 until Wave T5; it was two waves out of date
# and nothing referenced it, which is exactly how it went unnoticed.
crates/frees/pkg/
Cargo.lock.bak
*.wasm
!fixtures/**/*.wasm

# Java helper-tool build output (golden-dumper, dae-probe, table-gen)
tools/*/build/

# rollup-plugin-visualizer output — regenerated by every `npm run build`
web/stats.html

# TypeScript incremental build cache — regenerated by every `tsc`/`npm run build`
web/tsconfig.tsbuildinfo

# Written by the Pages deploy workflow (.github/workflows/deploy.yml) before
# the Vite build, standing in for the nginx image's container-start entrypoint.
web/public/build-info.js

# Local scratch files and helper scripts
/scratch/

# Audit evidence: the measurement harnesses and the CSV/JSON they emit. The
# audit's narrative documents (reports/*.md) ARE tracked; the raw evidence is
# not. SonarCloud analyses this repository with Automatic Analysis, whose
# exclusions live in the project settings UI and not in sonar-project.properties
# — so an evidence tree committed here fails the quality gate on its own
# measurement scripts and on the duplication between two snapshots of the same
# audit, and nothing in the repo can exempt it. Regenerate with measure.cjs.
reports/**/*.csv
reports/**/*.json
reports/**/*.cjs
reports/**/*.py
reports/**/*.txt
